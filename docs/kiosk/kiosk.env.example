# Kiosk-konfiguration — kopieres til ~/kiosk/kiosk.env på Pi'en
#
# Alt herunder er enhedens LOKALE opsætning. Driftsrytme (checkpoints,
# klokkeslæt, idle-mål) hører hjemme i Bons settings, ikke her — jf.
# CLAUDE_KIOSK.md §1.1 "Rytme er data, ikke kode".
#
# Ændrer du noget, så kør installeren igen — den bager bl.a. vinduesplacering
# og nødsidens adresse ind i andre filer.

# Konfigurationens version. Installeren advarer hvis den er ældre end
# eksemplet, så en gammel fil ikke tavst mangler nye indstillinger.
KIOSK_ENV_VERSION="2"

# Device-id fra kiosk_devices. Sendes som ?kiosk=<id>, så URL'en allerede nu
# er den §4.2 forventer når policy-systemet bygges. Får også login-siden til
# at vise PIN-padden.
KIOSK_DEVICE_ID="kokken-1"

# split  = Bon til venstre + Whiteboard til højre (to vinduer)
# single = ét vindue i fuld skærm
KIOSK_LAYOUT="split"

# Venstre/hoved-vinduet: køkkenets dashboard med topbar.
KIOSK_URL="https://bon.ristetrug.dk/kitchen/?kiosk=${KIOSK_DEVICE_ID}"

# Højre vindue i split-layout. Whiteboard er mobiloptimeret og har det fint
# på en tredjedel af skærmen.
KIOSK_SIDE_URL="https://whiteboard.ristetrug.dk/"

# Hvor stor en del af bredden hoved-vinduet får, som brøk. 2/3 på en
# 1920-skærm giver Bon 1280 px og Whiteboard 640 px.
KIOSK_MAIN_FRACTION="2/3"
# Zoom på den store / lille del. Over 1 bliver teksten større, men dashboardet
# mister plads i højden (1080 ÷ zoom).
KIOSK_MAIN_SCALE="1"
KIOSK_SIDE_SCALE="1"

# Skærmens opløsning. iiyama ProLite T2752MSC er Full HD.
KIOSK_SCREEN_WIDTH="1920"
KIOSK_SCREEN_HEIGHT="1080"

# Skjul Raspberry Pi OS' panel i toppen. Det kan ikke auto-skjule sig under
# labwc, og en kiosk skal ikke have en startmenu man kan komme til at trykke på.
KIOSK_HIDE_PANEL="1"

# Panelet slukkes og tændes på disse tider (man-fre). Slukningen ligger efter
# kl. 17, fordi der nogle dage er folk på arbejde til da.
KIOSK_OFF_TIME="17:30"
KIOSK_ON_TIME="06:30"
KIOSK_DAYS="Mon-Fri"

# URL watchdogen poller for at afgøre om Bon er nåelig.
KIOSK_HEALTH_URL="https://bon.ristetrug.dk/login.html"

# Output-navn. Tomt = første output wlr-randr finder. Sæt fx "HDMI-A-1"
# hvis der nogensinde hænger mere end én skærm på.
KIOSK_OUTPUT=""

# Sekunder uden berøring på nødsiden før den selv navigerer tilbage til Bon.
# §4.6: "kun efter idle — ingen hårde skift".
KIOSK_OFFLINE_IDLE_SECONDS="120"

# Valgfrit: SLZB-koordinatorens dashboard på LAN. Vises som knap på nødsiden.
# Lad stå tom indtil sensoropsætningen (§7.4) er på plads.
KIOSK_SLZB_URL=""
