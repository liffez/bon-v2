{
  "name": "bon-v2",
  "version": "2.0.0",
  "description": "Ristet Rug — Bon v2 Order Management System",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "node --experimental-sqlite --watch server.js",
    "migrate": "node --experimental-sqlite db/migrate.js",
    "seed": "node --experimental-sqlite db/seed.js",
    "setup": "node --experimental-sqlite db/migrate.js && node --experimental-sqlite db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.19.0",
    "imapflow": "^1.2.13",
    "mailparser": "^3.7.1",
    "nodemailer": "^8.0.2"
  }
}
