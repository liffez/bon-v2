# Kopiér denne fil til .env og udfyld værdierne
# .env må IKKE committes til git

PORT=4321
DB_PATH=./data/bon.db

# Produktionsflag — aktiverer secure cookies + trust proxy bag Nginx.
# SKAL sættes i produktion, ellers fejler login bag HTTPS-proxy.
NODE_ENV=production

# Delt cookie-domain — nødvendigt for at Nginx auth_request på
# whiteboard/sop/grocy-* subdomæner kan se Bon v2's session-cookie.
# SKAL sættes i produktion (ellers er cookien host-only og SSO går i loop).
# Lad være tom i dev.
COOKIE_DOMAIN=.ristetrug.dk

# Session-signeringsnøgle — generér en stærk streng i produktion:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Grocy (URL ligger i locations-tabellen — disse env-keys læses som fallback.
# Env-navn = GROCY_<code uppercased>_KEY, fx code='hq' → GROCY_HQ_KEY)
# GROCY_HQ_KEY=
# GROCY_CAFE_KEY=
# GROCY_TEST_KEY=

# Mail — passwords (host/port/user konfigureres i Settings UI)
SMTP_PASSWORD=
SMTP_KONTAKT_PASSWORD=
IMAP_BON_PASSWORD=
IMAP_KONTAKT_PASSWORD=

# Virk ElasticSearch (CVR-opslag)
VIRK_ES_USER=
VIRK_ES_PASS=

# Whiteboard Sidekick
WHITEBOARD_BASE_URL=https://whiteboard.ristetrug.dk
SOP_BASE_URL=https://sop.ristetrug.dk

# e-conomic
# ECONOMIC_APP_SECRET=
# ECONOMIC_AGREEMENT_GRANT=
