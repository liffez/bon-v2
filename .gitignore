# Miljøvariabler — aldrig i git!
.env
.env.*

# Node
node_modules/
npm-debug.log*

# Test-output (genereres ved hver kørsel)
tests/reports/
tests/fixtures/grocy_snapshot.json
test-results/
playwright-report/
.last-run.json

# DB-backups + fix-logs (lokal historik — ikke kode)
data/*.backup-*
data/*.pre-*
data/*-fix-log-*.json

# Review-CSV'er (ægte kundedata — aldrig i git)
data/*.csv

# Arkiv-blobs (binære, ikke versionsstyrede)
*.zip

# Claude Code worktrees (lokal arbejdsmappe)
.claude/worktrees/

# Lokale Claude-indstillinger — kan indeholde hemmeligheder (fx API-nøgler i
# tilladelsesregler). Repoet er OFFENTLIGT, så vi må ikke stole på at hver
# maskine har en global gitignore der fanger den.
.claude/settings.local.json

# Database
*.db
*.db-shm
*.db-wal
*.sqlite

# Mac
.DS_Store
data/attachments/
