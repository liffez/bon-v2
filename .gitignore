# Miljøvariabler — aldrig i git!
.env
.env.*
# Skabeloner SKAL med i git — de indeholder ingen hemmeligheder, og uden dem
# improviserer folk (fx `cp .env.example .env.test`, som giver produktionsværdier).
!.env.example
!.env.test.example

# Node
# Uden skråstreg, så et SYMLINK ved navn node_modules også fanges — i en worktree
# er der intet node_modules, og et symlink til hoved-repoets er den normale løsning.
node_modules
npm-debug.log*

# Test-output (genereres ved hver kørsel)
tests/reports/
tests/fixtures/grocy_snapshot.json
test-results/
playwright-report/
.last-run.json

# DB-backups + fix-logs (lokal historik — ikke kode)
# NB: både .backup- og .bak- forekommer i praksis på serveren.
data/*.backup-*
data/*.bak-*
data/*.pre-*
data/*-fix-log-*.json
# scripts/merge-duplicate-bon-lines.js --apply lægger sin VACUUM INTO-backup her.
# Utracket + uignoreret = git clean kan slette den. Det må ikke kunne ske.
data/backups/

# Runtime-output fra scripts og server (genskabes ved kørsel — ikke kilde).
# cvr-enrich-log.json skrives af scripts/enrich-cvr.js ved hver kørsel og
# gjorde serverens arbejdstræ beskidt ved hver deploy.
data/cvr-enrich-log.json
data/schema.sql
data/uploads/
logs/
sync.log

# Review-CSV'er (ægte kundedata — aldrig i git)
data/*.csv

# Genereret output fra scripts/generate-opret-helper.js (indeholder
# leverandørpriser — og genskabes ved hver kørsel, så det er ikke kilde)
data/horkram-status.json
data/horkram-opret-helper.html
tools/horkram-opret-helper.html

# Arkiv-blobs (binære, ikke versionsstyrede)
*.zip

# Claude Code worktrees (lokal arbejdsmappe)
.claude/worktrees/

# Lokale Claude-indstillinger — kan indeholde hemmeligheder (fx API-nøgler i
# tilladelsesregler). Vi må ikke stole på at hver maskine har en global
# gitignore der fanger den.
# (Rettelse 18. juli 2026: her stod tidligere at repoet er OFFENTLIGT. Det er
# det ikke — `gh repo view --json visibility` siger PRIVATE. Hemmeligheder skal
# stadig holdes ude af git, men brug ikke den påstand som præmis.)
.claude/settings.local.json

# Database
*.db
*.db-shm
*.db-wal
*.sqlite

# Mac
.DS_Store
data/attachments/
