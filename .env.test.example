# ══════════════════════════════════════════════════════════════
# Skabelon til .env.test — testmiljøet.
#
#   cp .env.test.example .env.test      ← og udfyld nøglerne nedenfor
#
# KOPIÉR IKKE .env.example TIL .env.test.
# Den er skabelonen for PRODUKTION og sætter NODE_ENV=production +
# DB_PATH=./data/bon.db. Gør man det, peger "testmiljøet" på driftens
# database — og test:reset ville køre migrations og seed-data ind i den.
# Det skete på Hetzner 18. juli 2026 (#338); safety_check fangede det,
# men først et trin for sent.
#
# .env.test hører KUN til på en udviklingsmaskine. Ligger den på serveren,
# så slet den — se test-tabellen i CLAUDE.md's deploy-afsnit.
# ══════════════════════════════════════════════════════════════

# Testserveren kører på en anden port end dev (4321), så begge kan køre samtidig.
PORT=4322

# SKAL indeholde 'test' — safety_check afviser at køre mod alt andet.
DB_PATH=./data/test.db

# SKAL være 'test'. Aktiverer bl.a. /api/test-ruterne som runnerne bruger
# til at inspicere mail- og webhook-buffere.
NODE_ENV=test

# Lad være tom lokalt. Sættes den, bliver session-cookien bundet til
# domænet og login i testserveren fejler.
COOKIE_DOMAIN=

# Vilkårlig streng — det er kun et testmiljø.
SESSION_SECRET=test-only-not-a-secret

# ── Grocy ─────────────────────────────────────────────────────
# SKAL pege på grocytest. safety_check kræver 'test' i URL'en, netop for
# at en fejlkonfiguration ikke kan nå produktionens Grocy: testene
# opretter, forbruger og sletter lagerbeholdning.
GROCY_API_URL=https://grocytest.ristetrug.dk/api
GROCY_API_KEY=
GROCY_TEST_KEY=

# ── Må IKKE sættes ────────────────────────────────────────────
# BON_V1_DB_PATH — safety_check afviser at køre hvis den er sat.
# Testene har ingen grund til at røre v1-data.

# ── Valgfrit ──────────────────────────────────────────────────
# Kun nødvendigt for de tracks der rører de pågældende integrationer.
# Lad dem stå tomme indtil en runner klager.
# HORKRAM_USER=
# HORKRAM_PASS=
# SMARTPLAN_CLIENT_ID=
# SMARTPLAN_CLIENT_SECRET=
